# Data files (download via kaggle CLI)
competitions/*/data/*.csv
competitions/*/data/*.zip
competitions/*/data/*.gz
competitions/*/data/*.tar.gz
competitions/*/data/kaggle-environments-*

# Python
__pycache__/
*.pyc
*.egg-info/
.hypothesis/
.pytest_cache/

# Submissions (can be regenerated)
competitions/*/submissions/*.csv
competitions/*/submissions/*.tar.gz

# Artifacts (downloaded kernel outputs, model weights, predictions - large/regenerable)
competitions/*/artifacts/

# Training scratch / local caches
catboost_info/
_transformer_out/
_kaggle_badges/
.venv-dl/

# Kiro
.kiro/

# IDE
.vscode/

# Misc
*.log

# scratch run logs
competitions/*/_*.out
competitions/*/_*.err
scripts/_*

competitions/*/*.log
competitions/*/*.err

# machine-specific compute override (keep compute.example.yaml)
compute.yaml

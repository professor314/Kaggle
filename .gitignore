# Data files (download via kaggle CLI)
competitions/*/data/*.csv
competitions/*/data/*.zip
competitions/*/data/*.gz
competitions/*/data/*.tar.gz
competitions/*/data/kaggle-environments-*

# Python
__pycache__/
*.pyc
*.egg-info/
.hypothesis/
.pytest_cache/

# Submissions (can be regenerated)
competitions/*/submissions/*.csv
competitions/*/submissions/*.tar.gz

# Artifacts (downloaded kernel outputs, model weights, predictions - large/regenerable)
competitions/*/artifacts/

# Training scratch / local caches
catboost_info/
_transformer_out/
_kaggle_badges/
.venv-dl/

# Kiro: keep steering docs in git (they ARE the workflow); ignore the rest
.kiro/*
!.kiro/steering/

# IDE
.vscode/

# Misc
*.log

# scratch run logs
competitions/*/_*.out
competitions/*/_*.err
scripts/_*

competitions/*/*.log
competitions/*/*.err

# machine-specific compute override (keep compute.example.yaml)
compute.yaml

scripts/*.log
scripts/*.err

competitions/*/artifacts_*/

# --- Big data / weights / regenerable outputs (local-only; not git, not Drive) ---
competitions/*/weights/
competitions/*/nli_model/
competitions/*/replays/
competitions/*/lb/
competitions/*/lb2/
competitions/*/evo/state_tourney/
competitions/*/evo/*_out.txt
_nli_ds/
_nlilabels_ds/
competitions/*/kernel_eval/
scripts/auc.txt

# Competition data and materials: never push (competition rules forbid redistribution)
competitions/*/data/
competitions/*/research/*.pdf
competitions/*/submissions/*.parquet
competitions/*/submissions/*.zip
competitions/*/submissions/*.npy

# Other people's public notebooks pulled for research (re-pull with kaggle kernels pull)
competitions/*/notebooks/ref*/

